{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-guild-summary.cjs",
    "build": "next build --webpack",
    "build:netlify": "NODE_ENV=production next build --webpack",
    "build:optimized": "node optimize-images.js && NODE_ENV=production next build --webpack",
    "dev": "next dev --webpack",
    "dev:netlify": "netlify dev",
    "lint": "eslint app components hooks lib services types netlify/functions tests scripts member-local --no-warn-ignored --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "node scripts/preview-static.cjs",
    "export": "npm run build",
    "test:api": "node --test tests/strategy-api.test.cjs tests/home-guides.test.cjs tests/guide-detail-read.test.cjs",
    "test": "npm run test:api && npm run test:security",
    "test:security": "node --test tests/function-boundary.test.cjs tests/password-security.test.cjs tests/function-inventory.test.cjs tests/export-csp.test.cjs tests/announcement-html.test.cjs tests/legacy-reward.test.cjs tests/freeze-release.test.cjs tests/test-resource.test.cjs tests/test-packaging.test.cjs tests/password-setup-diagnostic.test.cjs tests/test-env-provisioning.test.cjs tests/clean-npm-runner.test.cjs tests/member-local-boundary.test.cjs tests/member-local-ui.test.cjs",
    "test:test-environment": "node scripts/test-disposable-postgres.cjs",
    "test:environment": "node --test tests/environment-postgres.test.cjs",
    "test:session": "node --test tests/session-postgres.test.cjs",
    "test:integration": "node --test --test-concurrency=1 tests/strategy-postgres.test.cjs tests/guide-thumbnail-postgres.test.cjs tests/environment-postgres.test.cjs tests/member-migration-postgres.test.cjs tests/session-postgres.test.cjs",
    "deploy": "node deploy.js",
    "accounts:import": "node scripts/import_accounts_to_db.js",
    "deploy:preview": "node deploy.js",
    "deploy:prod": "node deploy.js",
    "analyze": "node optimize-images.js",
    "test:postgres": "node --test --test-concurrency=1 tests/strategy-postgres.test.cjs tests/guide-thumbnail-postgres.test.cjs",
    "postbuild": "node scripts/generate-export-csp.cjs",
    "postbuild:netlify": "node scripts/generate-export-csp.cjs",
    "postbuild:optimized": "node scripts/generate-export-csp.cjs",
    "test:member-local": "node tests/member-local-postgres.test.cjs",
    "member:local": "node scripts/member-local.cjs"
  },
