# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Local Netlify folder
.netlify

# Private account exports and member import data
/scripts/output/
/scripts/employee_ids_from_archive.csv
/scripts/member_profile_map.csv
