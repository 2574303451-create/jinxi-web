# Non-secret build proof is generated only for an approved TEST deployment.
/netlify/functions/_generated/
/artifacts/f03-f05/*.approval.local.sql
/artifacts/f03-f05/*.proof.local.json
/artifacts/f03-f05/*.provisioning.local.json
/test-environment/sql/*.local.sql

# The isolated React development renderer is never a published/static artifact.
/integration-local/site/.next/
/integration-local/site/next-env.d.ts
